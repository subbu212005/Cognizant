    private int activeRagStep = 1;
    private string ragStepTitle = "1. Document Source Ingestion";
    private string ragStepDesc = "In traditional applications, LLMs only know data they were trained on. In RAG, we start with custom knowledge databases: technical manuals, project wikis, databases, or local code repositories. These files serve as the ground truth context source.";

    private void SetRagStep(int step)
    {
        activeRagStep = step;
        switch (step)
        {
            case 1:
                ragStepTitle = "1. Document Source Ingestion";
                ragStepDesc = "In traditional applications, LLMs only know data they were trained on. In RAG, we start with custom knowledge databases: technical manuals, project wikis, databases, or local code repositories. These files serve as the ground truth context source.";
                break;
            case 2:
                ragStepTitle = "2. Smart Chunking & Segmentation";
                ragStepDesc = "Large files cannot fit inside an LLM's prompt window. We split files into small, logical 'chunks' (typically 500-1000 characters) with a slight character overlap (e.g. 100 characters). This ensures contextual links are preserved at boundaries.";
                break;
            case 3:
                ragStepTitle = "3. Vector Embedding Generation";
                ragStepDesc = "Each text chunk is sent to an embedding model (like text-embedding-3-small). The model converts text into a high-dimensional vector array (e.g. 1536 decimal values) representing its semantic meaning, so math can be used to compare text similarity.";
                break;
            case 4:
                ragStepTitle = "4. Vector Database Storage";
                ragStepDesc = "Vectors and their source text are indexed inside specialized databases (like Chroma, PGVector, or Pinecone). These databases allow querying using vector cosine similarity to retrieve documents based on concept search rather than exact keywords.";
                break;
            case 5:
                ragStepTitle = "5. User Prompt Execution";
                ragStepDesc = "A developer asks a question (e.g. 'How do I bind ports in my docker app?'). The query is first converted into a search vector using the same embedding model used during document ingestion.";
                break;
            case 6:
                ragStepTitle = "6. Similarity Context Retrieval";
                ragStepDesc = "The database performs a vector search comparing the user query vector against database records. It retrieves the top K (e.g. top 3) text chunks matching closest in vector angle, returning relevant context to the application backend.";
                break;
            case 7:
                ragStepTitle = "7. Grounded LLM Generation";
                ragStepDesc = "The application backend builds a combined prompt: system rules + retrieved database context + user question. The LLM processes this grounded prompt, outputting accurate responses based solely on document facts, eliminating hallucinations.";
                break;
        }
        StateHasChanged();
    }


