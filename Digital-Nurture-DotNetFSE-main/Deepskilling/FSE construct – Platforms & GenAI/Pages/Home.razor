    private void UpdateMetrics(object? state)
    {
        if (containerStatus != "RUNNING") return;

        var rand = new Random();
        if (cpuUsage > 50)
        {
            // Cool down stress load gradually
            cpuUsage -= rand.NextDouble() * 8;
            memoryUsage -= rand.Next(-5, 10);
        }
        else
        {
            // Base variance
            cpuUsage = 2.0 + rand.NextDouble() * 4.0;
            memoryUsage = 110 + rand.Next(-3, 4);
        }

        if (cpuUsage < 0) cpuUsage = 1.0;
        
        InvokeAsync(StateHasChanged);
    }

