    private void CommitChanges()
    {
        if (string.IsNullOrWhiteSpace(newCommitMessage))
        {
            newCommitMessage = "Update files";
        }

        string lastHash = gitCommits.Last().Hash;
        int lastIndex = gitCommits.Count;
        int nextX = 50 + (lastIndex * 85);
        if (nextX > 550)
        {
            gitTerminalLogs.Add("Error: Visual limit reached. Reset the tree or merge branches.");
            return;
        }

        string newHash = $"C{lastIndex + 1}";
        int yCoord = activeBranch == "main" ? 100 : 200;

        // Parent hash search on the same branch or branching point
        var branchParent = gitCommits.LastOrDefault(c => c.Branch == activeBranch);
        string parentHash = branchParent != null ? branchParent.Hash : lastHash;

        gitCommits.Add(new GitCommit(newHash, newCommitMessage, activeBranch, parentHash, nextX, yCoord));
        gitTerminalLogs.Add($"$ git commit -m \"{newCommitMessage}\"");
        gitTerminalLogs.Add($"[{activeBranch} {newHash}] {newCommitMessage}");
        gitTerminalLogs.Add($" HEAD is now at {newHash}");

        newCommitMessage = "";
        StateHasChanged();
    }

    private void CreateFeatureBranch()
    {
        if (gitCommits.Any(c => c.Branch == "feature")) return;

        string lastMainHash = gitCommits.Last(c => c.Branch == "main").Hash;
        int lastIndex = gitCommits.Count;
        int nextX = 50 + (lastIndex * 85);

        gitCommits.Add(new GitCommit($"C{lastIndex + 1}", "Checkout feature", "feature", lastMainHash, nextX, 200));
        activeBranch = "feature";

        gitTerminalLogs.Add("$ git checkout -b feature");
        gitTerminalLogs.Add("Switched to a new branch 'feature'");
        StateHasChanged();
    }

    private void SwitchBranch(string branch)
    {
        activeBranch = branch;
        gitTerminalLogs.Add($"$ git checkout {branch}");
        gitTerminalLogs.Add($"Switched to branch '{branch}'");
        StateHasChanged();
    }

    private void MergeFeatureBranch()
    {
        if (activeBranch != "feature") return;

        var lastMain = gitCommits.LastOrDefault(c => c.Branch == "main");
        var lastFeature = gitCommits.LastOrDefault(c => c.Branch == "feature");

        if (lastMain == null || lastFeature == null) return;

        int lastIndex = gitCommits.Count;
        int nextX = 50 + (lastIndex * 85);
        if (nextX > 550)
        {
            gitTerminalLogs.Add("Error: Visual limit reached. Reset the tree.");
            return;
        }

        string mergeHash = $"C{lastIndex + 1}";
        gitCommits.Add(new GitCommit(mergeHash, "Merge branch 'feature'", "main", lastMain.Hash, nextX, 100, isMerge: true, mergeParentHash: lastFeature.Hash));
        
        activeBranch = "main";
        gitTerminalLogs.Add("$ git checkout main");
        gitTerminalLogs.Add("Switched to branch 'main'");
        gitTerminalLogs.Add("$ git merge feature");
        gitTerminalLogs.Add("Updating " + lastMain.Hash + ".." + lastFeature.Hash);
        gitTerminalLogs.Add("Fast-forward or merge commit resolved successfully.");
        gitTerminalLogs.Add($"HEAD is now at {mergeHash} (Merge branch 'feature')");
        
        // Remove feature commits in simulation if needed, but keeping them visually is fine
        StateHasChanged();
    }

    private void ResetGit()
    {
        gitCommits.Clear();
        gitCommits.Add(new GitCommit("C1", "Initial Commit", "main", "", 50, 100));
        activeBranch = "main";
        gitTerminalLogs.Clear();
        gitTerminalLogs.Add("Initialized empty Git repository in /workspace/app/.git/");
        gitTerminalLogs.Add("Added file: index.html");
        gitTerminalLogs.Add("Added file: Program.cs");
        gitTerminalLogs.Add("Commit hash: C1 Created successfully");
        gitTerminalLogs.Add("HEAD is now at C1 (Initial Commit)");
        newCommitMessage = "";
        StateHasChanged();
    }


