    private string GetQuizProgressPercent()
    {
        double pct = ((double)currentQuestionIndex / quizQuestions.Count) * 100;
        return $"{pct}%";
    }

    private void StartQuiz()
    {
        if (string.IsNullOrWhiteSpace(userName)) return;
        quizActive = true;
        currentQuestionIndex = 0;
        quizScore = 0;
        selectedOptionIndex = null;
        showExplanation = false;
        quizCompleted = false;
        StateHasChanged();
    }

    private void SelectOption(int index)
    {
        if (showExplanation) return;
        selectedOptionIndex = index;
        StateHasChanged();
    }

    private void SubmitAnswer()
    {
        if (selectedOptionIndex == null || showExplanation) return;
        
        var q = quizQuestions[currentQuestionIndex];
        if (selectedOptionIndex == q.CorrectOptionIndex)
        {
            quizScore++;
        }
        showExplanation = true;
        StateHasChanged();
    }

    private void NextQuestion()
    {
        selectedOptionIndex = null;
        showExplanation = false;

        if (currentQuestionIndex < quizQuestions.Count - 1)
        {
            currentQuestionIndex++;
        }
        else
        {
            quizActive = false;
            quizCompleted = true;
        }
        StateHasChanged();
    }

    private void RetakeQuiz()
    {
        quizCompleted = false;
        quizActive = false;
        userName = "";
        StateHasChanged();
    }

    private async Task PrintCertificate()
    {
        // Simple JS trigger to open print dialog
        await IJSRuntime.InvokeVoidAsync("print");
    }
