    private async Task SendPromptPlayground()
    {
        if (isTypingResponse || string.IsNullOrWhiteSpace(promptText)) return;

        chatMessages.Add(new ChatMessage(promptText, true));
        string promptTypeSent = activePromptType;
        double temp = llmTemperature;
        isTypingResponse = true;
        llmResponse = "";
        StateHasChanged();

        string answer = "";
        if (promptTypeSent == "zero-shot")
        {
            answer = "Here is the simple English translation of the server logs:\n\n**Severity Level:** Critical (requires immediate attention).\n**Timestamp:** July 28, 2026.\n**Event:** The application failed to connect to database node 3 because the connection request was rejected (Error code 500 - Internal Server Error). Check database network settings.";
        }
        else if (promptTypeSent == "few-shot")
        {
            answer = " NEUTRAL\n\nExplanation: The feedback indicates the system is a standard, average installation without outstanding positive highlights or negative defects, fitting a neutral sentiment profile.";
        }
        else if (promptTypeSent == "cot")
        {
            answer = @"Here is the step-by-step calculation:

1. First, we identify the total number of nodes in the cluster: **3 nodes**.
2. Second, each node hosts 4 pods, so we multiply nodes by pods: 3 nodes * 4 pods/node = **12 pods** in total.
3. Third, each pod holds 2 container processes, so we multiply pods by containers: 12 pods * 2 containers/pod = **24 containers**.

Therefore, there are a total of **24 containers** running in the cluster.";
        }
        else
        {
            answer = @"{
  ""vulnerabilities"": [
    {
      ""issue"": ""Outdated base image version"",
      ""severity"": ""Medium"",
      ""details"": ""node:14 is deprecated and no longer receives security patches. Upgrade to node:20-alpine or node:22-bookworm.""
    },
    {
      ""issue"": ""Running as root user"",
      ""severity"": ""High"",
      ""details"": ""No USER instruction specified. The container process defaults to root, which could allow container escape exploits.""
    }
  ],
  ""status"": ""FAILED""
}";
        }

        // Typing effect
        foreach (var character in answer)
        {
            llmResponse += character;
            StateHasChanged();
            await Task.Delay(12);
        }

        chatMessages.Add(new ChatMessage(llmResponse, false));
        llmResponse = "";
        isTypingResponse = false;
        StateHasChanged();
    }


