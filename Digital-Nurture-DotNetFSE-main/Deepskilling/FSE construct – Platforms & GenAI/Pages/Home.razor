@page "/"
@using System.Threading
@inject IJSRuntime IJSRuntime

<PageTitle>FSE Construct – Platforms & GenAI</PageTitle>

<div class="dashboard-sidebar">
    <div class="sidebar-brand">
        <div class="brand-logo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="#ffffff" stroke-width="2" stroke-linejoin="round"/>
                <path d="M2 17L12 22L22 17" stroke="#ffffff" stroke-width="2" stroke-linejoin="round"/>
                <path d="M2 12L12 17L22 12" stroke="#ffffff" stroke-width="2" stroke-linejoin="round"/>
            </svg>
        </div>
        <div class="brand-text">Platforms & GenAI</div>
    </div>

    <div class="sidebar-nav">
        <button class="nav-link-item @(currentTab == "overview" ? "active" : "")" @onclick='() => SwitchTab("overview")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Overview
        </button>
        <button class="nav-link-item git-tab @(currentTab == "git" ? "active" : "")" @onclick='() => SwitchTab("git")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
            Git versioning
        </button>
        <button class="nav-link-item @(currentTab == "cicd" ? "active" : "")" @onclick='() => SwitchTab("cicd")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            CI/CD Pipeline
        </button>
        <button class="nav-link-item docker-tab @(currentTab == "docker" ? "active" : "")" @onclick='() => SwitchTab("docker")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            Containerization
        </button>
        <button class="nav-link-item genai-tab @(currentTab == "genai" ? "active" : "")" @onclick='() => SwitchTab("genai")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            GenAI Fundamentals
        </button>
        <button class="nav-link-item @(currentTab == "assessment" ? "active" : "")" @onclick='() => SwitchTab("assessment")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            Assessment Quiz
        </button>
    </div>

    <div class="sidebar-footer">
        <div class="footer-copy">© 2026–2027 Cognizant.</div>
        <div class="footer-copy" style="font-size: 0.65rem; color: #555;">All rights reserved.</div>
    </div>
</div>

<div class="dashboard-content">
    @if (currentTab == "overview")
    {
        <div class="glass-panel mb-2">
            <h1 class="mb-1 text-gradient-purple" style="font-size: 2.25rem;">Platforms & GenAI Construct</h1>
            <p style="color: var(--text-secondary); max-width: 800px; line-height: 1.6;">
                These are the enablers as a base to host the application developed using the Engineering concepts, programming languages, products, and frameworks to make it accessible by all users, reliable, and scalable.
            </p>
        </div>

        <div class="dashboard-grid">
            <div class="glass-panel module-card" style="--card-color: var(--clr-git); --card-color-glow: var(--clr-git-glow);" @onclick='() => SwitchTab("git")'>
                <div>
                    <div class="module-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                    </div>
                    <div class="module-title">Git Version Control</div>
                    <div class="module-desc">Collaborative codebase tracking, branching strategies, commit history management, and merging algorithms.</div>
                </div>
                <div class="module-status">
                    <span>Status:</span>
                    <span class="status-label status-git">@(gitCommits.Count > 1 ? "In Progress" : "Not Started")</span>
                </div>
            </div>

            <div class="glass-panel module-card" style="--card-color: var(--clr-cicd); --card-color-glow: var(--clr-cicd-glow);" @onclick='() => SwitchTab("cicd")'>
                <div>
                    <div class="module-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    </div>
                    <div class="module-title">CI/CD Pipeline</div>
                    <div class="module-desc">Continuous build validation, integration tests, static code analysis, security scans, and deployment scripts.</div>
                </div>
                <div class="module-status">
                    <span>Status:</span>
                    <span class="status-label status-cicd">@(ciStatus == "Idle" ? "Not Started" : ciStatus)</span>
                </div>
            </div>

            <div class="glass-panel module-card" style="--card-color: var(--clr-docker); --card-color-glow: var(--clr-docker-glow);" @onclick='() => SwitchTab("docker")'>
                <div>
                    <div class="module-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    </div>
                    <div class="module-title">Docker Containerization</div>
                    <div class="module-desc">Writing custom Dockerfiles, container isolation, port mappings, environment controls, and lifecycle.</div>
                </div>
                <div class="module-status">
                    <span>Status:</span>
                    <span class="status-label status-docker">@containerStatus</span>
                </div>
            </div>

            <div class="glass-panel module-card" style="--card-color: var(--clr-genai); --card-color-glow: var(--clr-genai-glow);" @onclick='() => SwitchTab("genai")'>
                <div>
                    <div class="module-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                    </div>
                    <div class="module-title">GenAI Fundamentals</div>
                    <div class="module-desc">Prompt engineering techniques, LLM generation settings, temperature mappings, and RAG pipelines.</div>
                </div>
                <div class="module-status">
                    <span>Status:</span>
                    <span class="status-label status-genai">Ready</span>
                </div>
            </div>
        </div>

        <div class="glass-panel flowchart-container">
            <div class="flowchart-title">The Engineering Platform Workflow</div>
            <div class="flowchart-svg-wrapper">
                <svg class="flowchart-svg" viewBox="0 0 850 160">
                    <defs>
                        <linearGradient id="grad-git" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#f87171"/>
                            <stop offset="100%" stop-color="#ef4444"/>
                        </linearGradient>
                        <linearGradient id="grad-cicd" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#818cf8"/>
                            <stop offset="100%" stop-color="#6366f1"/>
                        </linearGradient>
                        <linearGradient id="grad-docker" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#38bdf8"/>
                            <stop offset="100%" stop-color="#0ea5e9"/>
                        </linearGradient>
                        <linearGradient id="grad-genai" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#34d399"/>
                            <stop offset="100%" stop-color="#10b981"/>
                        </linearGradient>
                    </defs>
                    
                    <!-- Nodes -->
                    <g class="flowchart-node" style="--node-color: var(--clr-git);" @onclick='() => SwitchTab("git")'>
                        <rect x="10" y="40" width="160" height="80" rx="12" fill="rgba(240, 80, 50, 0.05)" stroke="url(#grad-git)" stroke-width="2"/>
                        <text x="90" y="75" fill="#ffffff" font-size="14" font-weight="600" text-anchor="middle">Git Versioning</text>
                        <text x="90" y="98" fill="var(--text-secondary)" font-size="11" text-anchor="middle">Commit, Branch & Push</text>
                    </g>
                    
                    <!-- Arrow 1 -->
                    <line x1="170" y1="80" x2="220" y2="80" stroke="rgba(255,255,255,0.15)" stroke-width="2" marker-end="url(#arrow)"/>
                    
                    <g class="flowchart-node" style="--node-color: var(--clr-cicd);" @onclick='() => SwitchTab("cicd")'>
                        <rect x="220" y="40" width="160" height="80" rx="12" fill="rgba(99, 102, 241, 0.05)" stroke="url(#grad-cicd)" stroke-width="2"/>
                        <text x="300" y="75" fill="#ffffff" font-size="14" font-weight="600" text-anchor="middle">CI/CD Pipeline</text>
                        <text x="300" y="98" fill="var(--text-secondary)" font-size="11" text-anchor="middle">Lint, Test & Scan</text>
                    </g>
                    
                    <!-- Arrow 2 -->
                    <line x1="380" y1="80" x2="430" y2="80" stroke="rgba(255,255,255,0.15)" stroke-width="2" marker-end="url(#arrow)"/>
                    
                    <g class="flowchart-node" style="--node-color: var(--clr-docker);" @onclick='() => SwitchTab("docker")'>
                        <rect x="430" y="40" width="160" height="80" rx="12" fill="rgba(13, 183, 237, 0.05)" stroke="url(#grad-docker)" stroke-width="2"/>
                        <text x="510" y="75" fill="#ffffff" font-size="14" font-weight="600" text-anchor="middle">Docker Container</text>
                        <text x="510" y="98" fill="var(--text-secondary)" font-size="11" text-anchor="middle">Package & Isolate</text>
                    </g>
                    
                    <!-- Arrow 3 -->
                    <line x1="590" y1="80" x2="640" y2="80" stroke="rgba(255,255,255,0.15)" stroke-width="2" marker-end="url(#arrow)"/>
                    
                    <g class="flowchart-node" style="--node-color: var(--clr-genai);" @onclick='() => SwitchTab("genai")'>
                        <rect x="640" y="40" width="160" height="80" rx="12" fill="rgba(16, 185, 129, 0.05)" stroke="url(#grad-genai)" stroke-width="2"/>
                        <text x="720" y="75" fill="#ffffff" font-size="14" font-weight="600" text-anchor="middle">GenAI Assist</text>
                        <text x="720" y="98" fill="var(--text-secondary)" font-size="11" text-anchor="middle">RAG & Prompt Ops</text>
                    </g>
                    
                    <!-- Marker Definition -->
                    <defs>
                        <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M 0 1 L 10 5 L 0 9 z" fill="rgba(255,255,255,0.3)"/>
                        </marker>
                    </defs>
                </svg>
            </div>
        </div>
    }
    else if (currentTab == "git")
    {
        <div class="glass-panel mb-2">
            <span class="badge badge-git">Git Versioning</span>
            <h1 class="mt-2 mb-1">Git Repository Playground</h1>
            <p style="color: var(--text-secondary);">Manage branches, create commits, and merge code using standard Git syntax. Watch the branching graph draw dynamically.</p>
        </div>

        <div class="git-layout">
            <div class="glass-panel git-graph-panel">
                <div class="flex-between">
                    <span style="font-weight: 600; font-size: 1.1rem;">Visual Branching Tree</span>
                    <span style="font-size: 0.85rem; color: var(--text-secondary);">Active Branch: <strong style="color: @(activeBranch == "main" ? "var(--clr-git)" : "#a78bfa");">@activeBranch</strong></span>
                </div>
                
                <div class="git-graph-svg-wrapper">
                    <svg width="100%" height="100%" style="background: #020408;">
                        <!-- Grid Lines -->
                        <line x1="0" y1="100" x2="600" y2="100" stroke="rgba(255,255,255,0.05)" stroke-dasharray="4,4"/>
                        <line x1="0" y1="200" x2="600" y2="200" stroke="rgba(255,255,255,0.05)" stroke-dasharray="4,4"/>
                        
                        <!-- Track Labels -->
                        <text x="15" y="95" fill="var(--clr-git)" font-size="10" font-weight="600" letter-spacing="1">MAIN</text>
                        <text x="15" y="195" fill="#a78bfa" font-size="10" font-weight="600" letter-spacing="1">FEATURE</text>

                        <!-- Git Commit Links -->
                        @for (int i = 0; i < gitCommits.Count; i++)
                        {
                            var commit = gitCommits[i];
                            if (i > 0)
                            {
                                var parent = gitCommits.FirstOrDefault(c => c.Hash == commit.ParentHash);
                                if (parent != null)
                                {
                                    <line x1="@parent.X" y1="@parent.Y" x2="@commit.X" y2="@commit.Y" stroke="@(commit.Branch == "main" ? "var(--clr-git)" : "#a78bfa")" stroke-width="3" stroke-linecap="round"/>
                                    @if (commit.IsMerge)
                                    {
                                        <!-- Draw diagonal merge connection -->
                                        var mergeParent = gitCommits.FirstOrDefault(c => c.Branch == "feature" && c.Hash == commit.MergeParentHash);
                                        if (mergeParent != null)
                                        {
                                            <line x1="@mergeParent.X" y1="@mergeParent.Y" x2="@commit.X" y2="@commit.Y" stroke="#c084fc" stroke-dasharray="4,4" stroke-width="2"/>
                                        }
                                    }
                                }
                            }
                        }

                        <!-- Git Commit Nodes -->
                        @foreach (var commit in gitCommits)
                        {
                            <g>
                                <circle cx="@commit.X" cy="@commit.Y" r="14" fill="#090d16" stroke="@(commit.Branch == "main" ? "var(--clr-git)" : "#a78bfa")" stroke-width="3" style="cursor: pointer;"/>
                                <text x="@commit.X" y="@(commit.Y + 4)" fill="#ffffff" font-size="9" font-weight="700" text-anchor="middle">@commit.Hash</text>
                                <text x="@commit.X" y="@(commit.Y - 22)" fill="var(--text-primary)" font-size="9" text-anchor="middle" font-weight="500">@commit.Message</text>
                            </g>
                        }
                    </svg>
                </div>

                <div class="control-btn-group" style="margin-top: 1.5rem;">
                    <div class="form-group" style="flex-grow: 1; min-width: 200px; margin-bottom: 0;">
                        <input class="form-input" style="padding: 0.5rem;" @bind="newCommitMessage" placeholder="Commit message..." />
                    </div>
                    <button class="btn-custom btn-git" @onclick="CommitChanges">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                        Git Commit
                    </button>
                    @if (activeBranch == "main" && !gitCommits.Any(c => c.Branch == "feature"))
                    {
                        <button class="btn-custom" @onclick="CreateFeatureBranch">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-6a2 2 0 0 0-2 2v8"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="20" r="3"/></svg>
                            Create Branch
                        </button>
                    }
                    @if (activeBranch == "main" && gitCommits.Any(c => c.Branch == "feature"))
                    {
                        <button class="btn-custom" @onclick='() => SwitchBranch("feature")'>
                            Switch to 'feature'
                        </button>
                    }
                    @if (activeBranch == "feature")
                    {
                        <button class="btn-custom" @onclick='() => SwitchBranch("main")'>
                            Switch to 'main'
                        </button>
                        <button class="btn-custom btn-git" @onclick="MergeFeatureBranch">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22V12m0 0H2m10 0h10"/></svg>
                            Merge into main
                        </button>
                    }
                    <button class="btn-custom" @onclick="ResetGit">Reset Repo</button>
                </div>
            </div>

            <div class="glass-panel">
                <span style="font-weight: 600; font-size: 1.1rem;">Interactive Git Command Builder</span>
                
                <div style="margin-top: 1rem; display: flex; flex-direction: column; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Select Git Action</label>
                        <select class="form-select" @onchange="OnGitActionSelected">
                            <option value="init">Initialize Repository (git init)</option>
                            <option value="clone">Clone Remote Repository (git clone)</option>
                            <option value="status">Check File Status (git status)</option>
                            <option value="add">Stage Changes (git add)</option>
                            <option value="commit">Commit Changes (git commit)</option>
                            <option value="branch">List & Create Branches (git branch)</option>
                            <option value="checkout">Switch Branches (git checkout)</option>
                            <option value="merge">Merge Branches (git merge)</option>
                            <option value="push">Push to Remote (git push)</option>
                        </select>
                    </div>

                    <div style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
                        <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Generated Command</div>
                        <div style="font-family: var(--font-mono); font-size: 1.1rem; color: #a78bfa; margin-top: 0.5rem; background: #000; padding: 0.75rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.05);">
                            @generatedGitCmd
                        </div>
                        <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.75rem; line-height: 1.5;">
                            @gitCmdExplanation
                        </div>
                    </div>
                </div>

                <div class="git-console">
                    <div class="console-header">
                        <div class="console-dot-group">
                            <span class="console-dot" style="background: #ef4444;"></span>
                            <span class="console-dot" style="background: #fb923c;"></span>
                            <span class="console-dot" style="background: #4ade80;"></span>
                        </div>
                        <div class="console-title">bash - git log output</div>
                    </div>
                    <div class="console-body">
                        @foreach (var log in gitTerminalLogs)
                        {
                            <div class="console-output">@log</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (currentTab == "cicd")
    {
        <div class="glass-panel mb-2">
            <span class="badge badge-cicd">CI/CD Automation</span>
            <h1 class="mt-2 mb-1">CI/CD Pipeline Simulator</h1>
            <p style="color: var(--text-secondary);">Automate building, linting, testing, scanning, packaging, and deploying applications dynamically.</p>
        </div>

        <div class="cicd-layout">
            <div class="pipeline-timeline">
                <div class="pipeline-timeline-progress" style="width: @ciProgressPercent;"></div>
                
                <div class="pipeline-step @(GetStepCssClass(0))">
                    <div class="step-node">1</div>
                    <div class="step-label">Source</div>
                </div>
                <div class="pipeline-step @(GetStepCssClass(1))">
                    <div class="step-node">2</div>
                    <div class="step-label">Lint</div>
                </div>
                <div class="pipeline-step @(GetStepCssClass(2))">
                    <div class="step-node">3</div>
                    <div class="step-label">Test</div>
                </div>
                <div class="pipeline-step @(GetStepCssClass(3))">
                    <div class="step-node">4</div>
                    <div class="step-label">Scan</div>
                </div>
                <div class="pipeline-step @(GetStepCssClass(4))">
                    <div class="step-node">5</div>
                    <div class="step-label">Build</div>
                </div>
                <div class="pipeline-step @(GetStepCssClass(5))">
                    <div class="step-node">6</div>
                    <div class="step-label">Deploy</div>
                </div>
            </div>

            <div class="cicd-console-wrapper">
                <div class="cicd-console">
                    <div class="console-header">
                        <div class="console-dot-group">
                            <span class="console-dot" style="background: #ef4444;"></span>
                            <span class="console-dot" style="background: #fb923c;"></span>
                            <span class="console-dot" style="background: #4ade80;"></span>
                        </div>
                        <div class="console-title">GitHub Actions runner logs</div>
                        <div>
                            @if (ciStatus == "Running")
                            {
                                <span style="font-size: 0.75rem; color: #fb7185; display: flex; align-items: center; gap: 0.35rem;">
                                    <span class="status-dot active"></span> In Progress...
                                </span>
                            }
                            else
                            {
                                <span style="font-size: 0.75rem; color: var(--text-muted);">Status: @ciStatus</span>
                            }
                        </div>
                    </div>
                    <div class="cicd-console-body" id="cicd-logs">
                        @if (string.IsNullOrEmpty(ciLogs))
                        {
                            <div style="color: #6b7280; text-align: center; margin-top: 5rem; font-family: var(--font-sans);">
                                Pipeline is ready. Click "Trigger Pipeline" to execute build jobs.
                            </div>
                        }
                        else
                        {
                            <pre style="margin: 0; color: #a7f3d0; font-family: var(--font-mono); white-space: pre-wrap;">@ciLogs</pre>
                        }
                    </div>
                    <div style="padding: 1rem; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 1rem;">
                        <button class="btn-custom" @onclick="ResetPipeline" disabled="@(ciStatus == "Running")">Reset</button>
                        <button class="btn-custom btn-git" style="border-color: rgba(99, 102, 241, 0.4);" @onclick="RunPipelineAsync" disabled="@(ciStatus == "Running")">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                            Trigger Pipeline
                        </button>
                    </div>
                </div>

                <div class="glass-panel yaml-config-panel">
                    <span style="font-weight: 600; font-size: 1.1rem; margin-bottom: 0.5rem;">Pipeline Config Syntaxes</span>
                    <p style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 1rem;">Inspect configuration models for different CI engines.</p>
                    
                    <div class="yaml-tabs">
                        <span class="yaml-tab @(selectedYaml == "github" ? "active" : "")" @onclick='() => selectedYaml = "github"'>GitHub Actions</span>
                        <span class="yaml-tab @(selectedYaml == "gitlab" ? "active" : "")" @onclick='() => selectedYaml = "gitlab"'>GitLab CI</span>
                        <span class="yaml-tab @(selectedYaml == "jenkins" ? "active" : "")" @onclick='() => selectedYaml = "jenkins"'>Jenkinsfile</span>
                    </div>

                    <div class="code-block">@GetYamlConfig()</div>
                </div>
            </div>
        </div>
    }
    else if (currentTab == "docker")
    {
        <div class="glass-panel mb-2">
            <span class="badge badge-docker">Containerization</span>
            <h1 class="mt-2 mb-1">Docker Environment Sandbox</h1>
            <p style="color: var(--text-secondary);">Build container configurations dynamically and manage simulated running instances under stress loads.</p>
        </div>

        <div class="docker-layout">
            <div class="glass-panel docker-builder-panel">
                <span style="font-weight: 600; font-size: 1.1rem;">Dockerfile Interactive Compiler</span>
                
                <div class="form-group">
                    <label class="form-label">Application Base Environment</label>
                    <select class="form-select" @onchange="OnDockerLangChanged">
                        <option value="dotnet">ASP.NET Core (C#)</option>
                        <option value="node">Node.js (Express)</option>
                        <option value="python">Python (Flask)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Host Port Binding</label>
                    <input class="form-input" @bind="exposedPort" @bind:event="oninput" placeholder="8080" />
                </div>

                <div class="form-group">
                    <label class="form-label">Container Base Image</label>
                    <input class="form-input" @bind="baseImage" readonly style="opacity: 0.7;" />
                </div>

                <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600; margin-bottom: -0.5rem; text-transform: uppercase;">Dockerfile Code</div>
                <div class="code-block" style="max-height: 250px;">@GetDockerfileCode()</div>
            </div>

            <div class="glass-panel docker-status-panel">
                <div class="container-monitor">
                    <div class="monitor-header">
                        <div>
                            <div style="font-weight: 700; font-size: 1.1rem;">Container Dashboard</div>
                            <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.25rem;">my-genai-app:latest</div>
                        </div>
                        <div class="status-indicator">
                            <span class="status-dot @(containerStatus == "RUNNING" ? "active" : "")"></span>
                            <span>@containerStatus</span>
                        </div>
                    </div>

                    <div class="monitor-metrics">
                        <div class="metric-card">
                            <div class="metric-val">@(containerStatus == "RUNNING" ? $"{cpuUsage:F1}%" : "0.0%")</div>
                            <div class="metric-lbl">CPU Usage</div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-val">@(containerStatus == "RUNNING" ? $"{memoryUsage} MB" : "0 MB")</div>
                            <div class="metric-lbl">RAM Usage</div>
                        </div>
                    </div>

                    <div class="control-btn-group" style="justify-content: center; gap: 1rem;">
                        @if (containerStatus == "STOPPED")
                        {
                            <button class="btn-custom btn-git" style="border-color: rgba(13, 183, 237, 0.4); width: 100%;" @onclick="StartContainer">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                Start Container
                            </button>
                        }
                        else
                        {
                            <button class="btn-custom" style="border-color: rgba(239, 68, 68, 0.4); color: #ef4444; width: 48%;" @onclick="StopContainer">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/></svg>
                                Stop
                            </button>
                            <button class="btn-custom" style="border-color: rgba(245, 158, 11, 0.4); width: 48%;" @onclick="TriggerStressLoad">
                                Simulate Load
                            </button>
                        }
                    </div>
                </div>

                <div class="git-console" style="margin-top: 0;">
                    <div class="console-header">
                        <div class="console-dot-group">
                            <span class="console-dot" style="background: #ef4444;"></span>
                            <span class="console-dot" style="background: #fb923c;"></span>
                            <span class="console-dot" style="background: #4ade80;"></span>
                        </div>
                        <div class="console-title">stdout logs</div>
                    </div>
                    <div class="console-body" style="min-height: 150px; font-size: 0.75rem;">
                        @foreach (var log in dockerTerminalLogs)
                        {
                            <div class="console-output">@log</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (currentTab == "genai")
    {
        <div class="glass-panel mb-2">
            <span class="badge badge-genai">GenAI Fundamentals</span>
            <h1 class="mt-2 mb-1">Generative AI Playground</h1>
            <p style="color: var(--text-secondary);">Interact with different prompt structures, set temperature mappings, and view RAG database workflows.</p>
        </div>

        <div class="genai-layout">
            <div class="glass-panel" style="display: flex; flex-direction: column; gap: 1.5rem;">
                <span style="font-weight: 600; font-size: 1.1rem;">Prompt Engineering Studio</span>
                
                <div class="form-group">
                    <label class="form-label">Prompting Technique</label>
                    <select class="form-select" @onchange="OnPromptTechniqueChanged">
                        <option value="zero-shot">Zero-Shot (Direct Query)</option>
                        <option value="few-shot">Few-Shot (Provided examples)</option>
                        <option value="cot">Chain of Thought (Reasoning steps)</option>
                        <option value="system">System Instruction Role</option>
                    </select>
                </div>

                <div class="form-group">
                    <div class="flex-between">
                        <label class="form-label">Temperature: @llmTemperature</label>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">Low: deterministic | High: creative</span>
                    </div>
                    <input type="range" class="form-range" min="0.0" max="1.5" step="0.1" @bind="llmTemperature" style="accent-color: var(--clr-genai); width: 100%;" />
                </div>

                <div class="form-group">
                    <label class="form-label">Structured Prompt Template</label>
                    <textarea class="form-input" style="height: 120px; font-family: var(--font-mono); font-size: 0.8rem; resize: none;" @bind="promptText"></textarea>
                </div>

                <button class="btn-custom btn-git" style="border-color: rgba(16, 185, 129, 0.4); justify-content: center;" @onclick="SendPromptPlayground" disabled="@isTypingResponse">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    Simulate Query Execution
                </button>
            </div>

            <div class="playground-chat">
                <div class="chat-header">
                    <div class="chat-bot-avatar">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M12 2v9M8 5h8"/></svg>
                    </div>
                    <div>
                        <div style="font-weight: 600; font-size: 0.9rem;">GenAI Simulated LLM Agent</div>
                        <div style="font-size: 0.7rem; color: var(--clr-genai);">Online - API active</div>
                    </div>
                </div>
                <div class="chat-body" id="chat-body-container">
                    <div class="chat-msg bot">
                        Hello! Select a prompting technique or write a custom query to evaluate the token probabilities, temperature thresholds, and outputs.
                    </div>
                    @foreach (var msg in chatMessages)
                    {
                        <div class="chat-msg @(msg.IsUser ? "user" : "bot")">
                            @msg.Text
                        </div>
                    }
                    @if (isTypingResponse)
                    {
                        <div class="chat-msg bot">
                            @llmResponse<span style="display: inline-block; width: 6px; height: 14px; background: var(--clr-genai); margin-left: 2px; animation: pulse 0.8s infiniteAlternate;"></span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="glass-panel rag-panel" style="margin-top: 2rem;">
            <div class="flex-between">
                <span style="font-weight: 600; font-size: 1.15rem;">Retrieval-Augmented Generation (RAG) Architecture</span>
                <span style="font-size: 0.8rem; color: var(--text-secondary);">Click on steps to inspect execution flow</span>
            </div>

            <div class="rag-diagram-wrapper">
                <svg width="100%" height="auto" viewBox="0 0 800 240" style="max-width: 800px;">
                    <!-- Data Source Node -->
                    <g style="cursor:pointer;" @onclick='() => SetRagStep(1)'>
                        <rect x="10" y="20" width="110" height="60" rx="8" fill="@(activeRagStep == 1 ? "rgba(16,185,129,0.15)" : "#0f172a")" stroke="@(activeRagStep == 1 ? "var(--clr-genai)" : "rgba(255,255,255,0.1)")" stroke-width="2"/>
                        <text x="65" y="45" fill="#ffffff" font-size="11" font-weight="600" text-anchor="middle">1. Documents</text>
                        <text x="65" y="60" fill="var(--text-secondary)" font-size="9" text-anchor="middle">PDFs, DBs, Wikis</text>
                    </g>
                    
                    <line x1="120" y1="50" x2="160" y2="50" stroke="rgba(255,255,255,0.15)" stroke-width="2" marker-end="url(#arrow)"/>

                    <!-- Ingestion / Chunking Node -->
                    <g style="cursor:pointer;" @onclick='() => SetRagStep(2)'>
                        <rect x="160" y="20" width="110" height="60" rx="8" fill="@(activeRagStep == 2 ? "rgba(16,185,129,0.15)" : "#0f172a")" stroke="@(activeRagStep == 2 ? "var(--clr-genai)" : "rgba(255,255,255,0.1)")" stroke-width="2"/>
                        <text x="215" y="45" fill="#ffffff" font-size="11" font-weight="600" text-anchor="middle">2. Chunking</text>
                        <text x="215" y="60" fill="var(--text-secondary)" font-size="9" text-anchor="middle">Split text & overlap</text>
                    </g>

                    <line x1="270" y1="50" x2="310" y2="50" stroke="rgba(255,255,255,0.15)" stroke-width="2" marker-end="url(#arrow)"/>

                    <!-- Vector Embedding Node -->
                    <g style="cursor:pointer;" @onclick='() => SetRagStep(3)'>
                        <rect x="310" y="20" width="110" height="60" rx="8" fill="@(activeRagStep == 3 ? "rgba(16,185,129,0.15)" : "#0f172a")" stroke="@(activeRagStep == 3 ? "var(--clr-genai)" : "rgba(255,255,255,0.1)")" stroke-width="2"/>
                        <text x="365" y="45" fill="#ffffff" font-size="11" font-weight="600" text-anchor="middle">3. Embeddings</text>
                        <text x="365" y="60" fill="var(--text-secondary)" font-size="9" text-anchor="middle">Model vector maps</text>
                    </g>

                    <line x1="420" y1="50" x2="460" y2="50" stroke="rgba(255,255,255,0.15)" stroke-width="2" marker-end="url(#arrow)"/>

                    <!-- Vector DB Node -->
                    <g style="cursor:pointer;" @onclick='() => SetRagStep(4)'>
                        <rect x="460" y="20" width="110" height="60" rx="8" fill="@(activeRagStep == 4 ? "rgba(16,185,129,0.15)" : "#0f172a")" stroke="@(activeRagStep == 4 ? "var(--clr-genai)" : "rgba(255,255,255,0.1)")" stroke-width="2"/>
                        <text x="515" y="45" fill="#ffffff" font-size="11" font-weight="600" text-anchor="middle">4. Vector DB</text>
                        <text x="515" y="60" fill="var(--text-secondary)" font-size="9" text-anchor="middle">Chroma, pgvector</text>
                    </g>

                    <!-- Query Interaction Track -->
                    <line x1="515" y1="80" x2="515" y2="135" stroke="rgba(255,255,255,0.15)" stroke-width="2" marker-end="url(#arrow)"/>
                    <line x1="215" y1="165" x2="260" y2="165" stroke="rgba(255,255,255,0.15)" stroke-width="2" marker-end="url(#arrow)"/>
                    <line x1="370" y1="165" x2="410" y2="165" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
                    <line x1="410" y1="165" x2="460" y2="50" stroke="var(--clr-genai)" stroke-dasharray="3,3" stroke-width="1.5"/>

                    <!-- Step 5: User Query -->
                    <g style="cursor:pointer;" @onclick='() => SetRagStep(5)'>
                        <rect x="100" y="135" width="115" height="60" rx="8" fill="@(activeRagStep == 5 ? "rgba(16,185,129,0.15)" : "#0f172a")" stroke="@(activeRagStep == 5 ? "var(--clr-genai)" : "rgba(255,255,255,0.1)")" stroke-width="2"/>
                        <text x="1575" y="160" fill="#ffffff" font-size="11" font-weight="600" text-anchor="middle" transform="translate(-1417, 0)">5. User Prompt</text>
                        <text x="1575" y="175" fill="var(--text-secondary)" font-size="9" text-anchor="middle" transform="translate(-1417, 0)">Query from frontend</text>
                    </g>

                    <!-- Step 6: Similarity Search & Retrieve -->
                    <g style="cursor:pointer;" @onclick='() => SetRagStep(6)'>
                        <rect x="260" y="135" width="110" height="60" rx="8" fill="@(activeRagStep == 6 ? "rgba(16,185,129,0.15)" : "#0f172a")" stroke="@(activeRagStep == 6 ? "var(--clr-genai)" : "rgba(255,255,255,0.1)")" stroke-width="2"/>
                        <text x="315" y="160" fill="#ffffff" font-size="11" font-weight="600" text-anchor="middle">6. Retrieve Context</text>
                        <text x="315" y="175" fill="var(--text-secondary)" font-size="9" text-anchor="middle">Cosine similarity match</text>
                    </g>

                    <!-- Connection from retrieve step to LLM prompt construction -->
                    <line x1="570" y1="50" x2="630" y2="105" stroke="var(--clr-genai)" stroke-width="2"/>
                    <line x1="215" y1="165" x2="630" y2="165" stroke="rgba(255,255,255,0.15)" stroke-width="2" stroke-dasharray="4,4"/>

                    <!-- Step 7: Prompt Synthesis & LLM Generation -->
                    <g style="cursor:pointer;" @onclick='() => SetRagStep(7)'>
                        <rect x="630" y="115" width="130" height="80" rx="8" fill="@(activeRagStep == 7 ? "rgba(16,185,129,0.15)" : "#0f172a")" stroke="@(activeRagStep == 7 ? "var(--clr-genai)" : "rgba(255,255,255,0.1)")" stroke-width="2"/>
                        <text x="695" y="145" fill="#ffffff" font-size="11" font-weight="600" text-anchor="middle">7. Generation</text>
                        <text x="695" y="160" fill="var(--text-secondary)" font-size="9" text-anchor="middle">LLM Synthesizes response</text>
                        <text x="695" y="175" fill="var(--clr-genai)" font-size="8.5" font-weight="600" text-anchor="middle">Grounded answer</text>
                    </g>
                </svg>
            </div>

            <div class="rag-step-desc">
                <h4>@ragStepTitle</h4>
                <p>@ragStepDesc</p>
            </div>
        </div>
    }
    else if (currentTab == "assessment")
    {
        <div class="glass-panel mb-2">
            <span class="badge badge-cicd" style="background: rgba(139, 92, 246, 0.15); color: var(--clr-accent); border-color: rgba(139, 92, 246, 0.3);">Construct Evaluation</span>
            <h1 class="mt-2 mb-1">Platforms & GenAI Final Assessment</h1>
            <p style="color: var(--text-secondary);">Test your comprehension across Git versioning, CI/CD pipelines, Docker container configuration, and GenAI fundamentals.</p>
        </div>

        <div class="quiz-container">
            @if (!quizActive && !quizCompleted)
            {
                <div class="glass-panel" style="text-align: center; padding: 3rem 2rem;">
                    <div style="width: 70px; height: 70px; border-radius: 50%; background: rgba(99,102,241,0.1); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto; color: var(--clr-cicd);">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M9 12l2 2 4-4"/></svg>
                    </div>
                    <h2 class="mb-1" style="font-size: 1.5rem;">Enter Candidate Details</h2>
                    <p style="color: var(--text-secondary); max-width: 450px; margin: 0 auto 2rem auto; font-size: 0.9rem;">
                        Provide your name below to register and instantiate the personalized evaluation environment. Your credential badge will be compiled upon scoring 70%+ correct marks.
                    </p>
                    
                    <div class="form-group" style="max-width: 320px; margin: 0 auto 1.5rem auto;">
                        <input class="form-input" style="text-align: center;" @bind="userName" placeholder="Full Name" />
                    </div>

                    <button class="btn-custom btn-git" style="border-color: rgba(99,102,241,0.4); padding: 0.75rem 2rem;" @onclick="StartQuiz" disabled="@string.IsNullOrEmpty(userName)">
                        Start Assessment
                    </button>
                </div>
            }
            else if (quizActive && !quizCompleted)
            {
                var q = quizQuestions[currentQuestionIndex];
                
                <div class="quiz-progress-bar">
                    <div class="quiz-progress-fill" style="width: @(GetQuizProgressPercent());"></div>
                </div>

                <div class="glass-panel quiz-card">
                    <div class="flex-between" style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                        <span style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted);">Question @(currentQuestionIndex + 1) of @quizQuestions.Count</span>
                        <span class="badge" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); color: var(--text-secondary);">@q.Category</span>
                    </div>

                    <div class="question-text">@q.QuestionText</div>

                    <div class="options-list">
                        @for (int idx = 0; idx < q.Options.Length; idx++)
                        {
                            var optionIndex = idx;
                            var isSelected = selectedOptionIndex == optionIndex;
                            var itemClass = "";
                            if (showExplanation)
                            {
                                if (optionIndex == q.CorrectOptionIndex) itemClass = "correct";
                                else if (isSelected) itemClass = "incorrect";
                            }
                            else if (isSelected)
                            {
                                itemClass = "selected";
                            }

                            <div class="option-item @itemClass" @onclick="() => SelectOption(optionIndex)">
                                <div class="option-bullet">@((char)('A' + optionIndex))</div>
                                <div>@q.Options[optionIndex]</div>
                            </div>
                        }
                    </div>

                    @if (showExplanation)
                    {
                        <div class="explanation-box">
                            <div class="explanation-title" style="color: @(selectedOptionIndex == q.CorrectOptionIndex ? "var(--clr-genai)" : "#ef4444")">
                                @(selectedOptionIndex == q.CorrectOptionIndex ? "Correct Answer!" : "Incorrect Answer")
                            </div>
                            <div class="explanation-text">@q.Explanation</div>
                        </div>
                    }

                    <div style="display:flex; justify-content: flex-end; margin-top: 1rem;">
                        @if (!showExplanation)
                        {
                            <button class="btn-custom btn-git" style="border-color: rgba(99,102,241,0.4);" @onclick="SubmitAnswer" disabled="@(selectedOptionIndex == null)">
                                Submit Answer
                            </button>
                        }
                        else
                        {
                            <button class="btn-custom" @onclick="NextQuestion">
                                @(currentQuestionIndex == quizQuestions.Count - 1 ? "Finish Assessment" : "Next Question")
                            </button>
                        }
                    </div>
                </div>
            }
            else if (quizCompleted)
            {
                <div class="glass-panel" style="text-align: center; padding: 2.5rem 1.5rem;">
                    <h2>Assessment Results</h2>
                    <div style="font-size: 3rem; font-weight: 800; color: @(quizScore >= 7 ? "var(--clr-genai)" : "#ef4444"); margin: 1rem 0; font-family: var(--font-mono)">
                        @quizScore / @quizQuestions.Count
                    </div>
                    <p style="color: var(--text-secondary); max-width: 480px; margin: 0 auto 2rem auto; font-size: 0.9rem;">
                        @if (quizScore >= 7)
                        {
                            <span>Congratulations, <strong>@userName</strong>! You have scored <strong>@(quizScore * 10)%</strong>, passing the FSE construct requirements. Your certificate has been compiled and is ready below.</span>
                        }
                        else
                        {
                            <span>You have scored <strong>@(quizScore * 10)%</strong>. A score of 70% or higher is required to qualify for certificate compilation. Try reviewing the modules and test again.</span>
                        }
                    </p>

                    <div style="display:flex; justify-content: center; gap: 1rem; margin-bottom: 2rem;">
                        <button class="btn-custom" @onclick="RetakeQuiz">Retake Assessment</button>
                        @if (quizScore >= 7)
                        {
                            <button class="btn-custom btn-git" style="border-color: rgba(16, 185, 129, 0.4);" @onclick="PrintCertificate">
                                Save / Print Badge
                            </button>
                        }
                    </div>

                    @if (quizScore >= 7)
                    {
                        <div class="certificate-wrapper" id="printable-area">
                            <div class="certificate-seal">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2"><path d="M12 2L2 7L12 12L22 7L12 2Z"/><path d="M2 17L12 22L22 17"/><path d="M2 12L12 17L22 12"/></svg>
                            </div>
                            <div class="certificate-title">Certificate of Completion</div>
                            <div class="certificate-subtitle">Cognizant Full Stack Engineering Construct</div>
                            
                            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px;">This credential is awarded to</div>
                            <div class="certificate-recipient">@userName</div>
                            
                            <div class="certificate-body">
                                For successfully completing the skilling curriculum and demonstrating practical competence in <strong>Git Versioning</strong>, <strong>CI/CD Pipelines</strong>, <strong>Docker Containerization</strong>, and <strong>Generative AI Fundamentals</strong>.
                            </div>
                            
                            <div class="certificate-footer">
                                <div class="sig-block">
                                    <div class="sig-line" style="font-family: 'Brush Script MT', cursive; font-size: 1.2rem; color: #d4af37; border-bottom: none; margin-bottom: 0;">FSE Core Committee</div>
                                    <div class="sig-line"></div>
                                    <div class="sig-name">Platform Steering Lead</div>
                                </div>
                                <div class="sig-block">
                                    <div class="sig-line" style="font-family: 'Brush Script MT', cursive; font-size: 1.2rem; color: #d4af37; border-bottom: none; margin-bottom: 0;">GenAI CoE</div>
                                    <div class="sig-line"></div>
                                    <div class="sig-name">GenAI Architect Lead</div>
                                </div>
                            </div>

                            <div style="font-size: 0.65rem; color: var(--text-muted); margin-top: 2rem;">Verification ID: FSE-PC-@(DateTime.Now.ToString("yyyyMMdd"))-@(new Random().Next(1000, 9999))</div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private string currentTab = "overview";

    private void SwitchTab(string tab)
    {
        currentTab = tab;
        StateHasChanged();
    }

    // ==========================================
    // GIT TAB DATA & STATE
    // ==========================================
    public class GitCommit
    {
        public string Hash { get; set; }
        public string Message { get; set; }
        public string Branch { get; set; }
        public string ParentHash { get; set; }
        public int X { get; set; }
        public int Y { get; set; }
        public bool IsMerge { get; set; }
        public string? MergeParentHash { get; set; }

        public GitCommit(string hash, string message, string branch, string parentHash, int x, int y, bool isMerge = false, string? mergeParentHash = null)
        {
            Hash = hash;
            Message = message;
            Branch = branch;
            ParentHash = parentHash;
            X = x;
            Y = y;
            IsMerge = isMerge;
            MergeParentHash = mergeParentHash;
        }
